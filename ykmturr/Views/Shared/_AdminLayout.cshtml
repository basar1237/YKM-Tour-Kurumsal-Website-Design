
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<title>ADMİN PANELİ</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
<body>

    <!-- Sidebar -->
    <div class="w3-sidebar w3-light-grey w3-bar-block" style="width:15%">
        <h3 class="w3-bar-item">Menu</h3>
        <a href="/Admin/Corporatee/" class="w3-bar-item w3-button">Corporate</a>
        <a href="/Admin/Index/" class="w3-bar-item w3-button">Hakkımızda</a>
        <a href="/Admin/İletisim/" class="w3-bar-item w3-button btn-info">İletişim</a>
        <a href="/Admin/Private/" class="w3-bar-item w3-button btn-danger">Private</a>
        <a href="/Admin/Populer/" class="w3-bar-item w3-button btn-danger">Populer</a>
  
        <a href="https://localhost:44357/Default" class="w3-bar-item w3-button btn-danger">Siteye Git</a>


    </div>

    <!-- Page Content -->
    <div style="margin-left:15%">

        <div class="w3-container " style="background-image: linear-gradient(120deg,#3498db,#8e44ad);">
            <h3 style="color:white;">Admin Yönetim Paneli</h3>
        </div>


        <div class="w3-container">
            @RenderBody()
             </div>

    </div>

</body>
