@using ykmturr.Models.Sınıflar
@model List<Main>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kişisel Web Sitesi</title>
    <link rel="stylesheet" href="~/seb-kişi/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.14.0/css/all.min.css">
</head>
<body>
    <div class="center">
        <div class="avatar">
            <img src="PvV5gdhb_400x400.jpg">
        </div>
        <div class="content">
            @foreach (var x in Model)
            {
                <h1> @x.Isim</h1>
                <h2>@x.Unvan</h2>
                <p>@x.Acıklama</p>
                <h3>@x.Pofil</h3>
            }
        </div>
        @Html.Action("İkonlar","Main")
    </div>

</body>
</html>