@using ykmturr.Models.Sınıflar
@model List<Hotel>
@{
    ViewBag.Title = "hotel";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th> Hotel Sayfası</th>


        <th>Sil</th>
        <th>Güncelle</th>
        <th>Detaylar</th>
    </tr>

    @foreach (var x in Model)
    {
        <tr>
            <td>@x.ID</td>
            <td>@x.Baslik1</td>


            <td><a href="#" class="btn btn-danger">Sil</td>
            <td><a href="/Admin/HotelGetir/@x.ID" class="btn btn-warning">Güncelle</td>
            <td><a href="#" class="btn btn-default">Detaylar</td>

        </tr>
    }

</table>
