@model ykmturr.Models.Sınıflar.Private
@{
    ViewBag.Title = "PrivateGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<h2>Private Güncelleme Sayfası</h2>
<br />
@using (Html.BeginForm("PrivateGuncelle", "Admin", FormMethod.Post))
{

    <form class="form-group" method="post">
        @Html.LabelFor(x => x.Id)
        @Html.TextBoxFor(x => x.Id, new { @class = "form-control", @readonly = "readonly" })
        <br />
        @Html.LabelFor(x => x.Baslik1)
        @Html.TextBoxFor(x => x.Baslik1, new { @class = "form-control" })
        <br />
        @Html.LabelFor(x => x.Aciklama1)
        @Html.TextAreaFor(x => x.Aciklama1, 5, 1, new { @class = "form-control" })
        <br />
        @Html.LabelFor(x => x.Baslik2)
        @Html.TextBoxFor(x => x.Baslik2, new { @class = "form-control" })

        <br />
        @Html.LabelFor(x => x.Aciklama2)
        @Html.TextAreaFor(x => x.Aciklama2, 5, 1, new { @class = "form-control" })
        <br />
        @Html.LabelFor(x => x.Baslik3)
        @Html.TextAreaFor(x => x.Baslik3, new { @class = "form-control" })

        <br />
        @Html.LabelFor(x => x.Aciklama3)
        @Html.TextAreaFor(x => x.Aciklama3, 5, 1, new { @class = "form-control" })
        <br />
        @Html.LabelFor(x => x.Baslik4)
        @Html.TextAreaFor(x => x.Baslik4, new { @class = "form-control" })

        <br />
        @Html.LabelFor(x => x.Aciklama4)
        @Html.TextAreaFor(x => x.Aciklama4, 5, 1, new { @class = "form-control" })
        <br />
        @Html.LabelFor(x => x.Baslik5)
        @Html.TextAreaFor(x => x.Baslik5, new { @class = "form-control" })

        <br />
        @Html.LabelFor(x => x.Aciklama5)
        @Html.TextAreaFor(x => x.Aciklama5, 5, 1, new { @class = "form-control" })
        <br />

        @Html.LabelFor(x => x.FotoUrl)
        @Html.TextBoxFor(x => x.FotoUrl, new { @class = "form-control" })
        <br />
        @Html.LabelFor(x => x.TurBaslik1)
        @Html.TextAreaFor(x => x.TurBaslik1, new { @class = "form-control" })

        <br />
        @Html.LabelFor(x => x.turFotoUrl1)
        @Html.TextBoxFor(x => x.turFotoUrl1, new { @class = "form-control" })
        <br />


        @Html.LabelFor(x => x.TurBaslik2)
        @Html.TextAreaFor(x => x.TurBaslik2, new { @class = "form-control" })

        <br />

        @Html.LabelFor(x => x.turFotoUrl2)
        @Html.TextBoxFor(x => x.turFotoUrl2, new { @class = "form-control" })
        <br />

        @Html.LabelFor(x => x.TurBaslik3)
        @Html.TextAreaFor(x => x.TurBaslik3, new { @class = "form-control" })

        <br />
        @Html.LabelFor(x => x.turFotoUrl3)
        @Html.TextBoxFor(x => x.turFotoUrl3, new { @class = "form-control" })
        <br />

        <button class="btn btn-primary">Güncelle </button>
    </form>



}



