@using ykmturr.Models.Sınıflar;
@model List<Private>


<section class="w3l-specification-6">
    <div class="specification-layout editContent">
        <div class="container">
            @foreach (var x in Model)
            {
            <div class="grid">
                <figure class="effect-apollo ser-bg1" style="background-image: url('@x.turFotoUrl1');">
                    <figcaption>
                        <h5><a href="#url">@x.TurBaslik1</a></h5>

                    </figcaption>
                </figure>
                <figure class="effect-apollo ser-bg1" style="background-image: url('@x.turFotoUrl2'); ">
                    <figcaption>
                        <h5><a href="#url">@x.TurBaslik2</a></h5>
                    </figcaption>
                </figure>
                <figure class="effect-apollo ser-bg1" style="background-image: url('@x.turFotoUrl3');">
                    <figcaption>
                        <h5><a href="#url">@x.TurBaslik3</a></h5>
                    </figcaption>
                </figure>
            </div>
            }
        </div>
    </div>
</section>

   

